-		credential.RefreshTokenExpiresAt = new(requestedAt.Add(time.Duration(token.RefreshTokenExpiresIn) * time.Second))
+		credential.RefreshTokenExpiresAt = new(requestedAt.Add(token.RefreshTokenExpiresIn))
 	}
 	return credential
 }
